# Upstream sync protection — mark pure branding files with merge=ours.
# Code files with rebrand strings are NOT marked; the post-merge rebrand
# script (scripts/post-merge-rebrand.sh) re-applies our replacements
# after upstream merges, so new upstream features flow through.

# ── Pure branding files (keep merge=ours) ──────────────────────────────────
# These are files where our changes are purely text/name replacements and
# upstream should never override them.

# Root
README.md          merge=ours
install.sh         merge=ours

# Legal
LICENSE-MIT        merge=ours
NOTICE             merge=ours

# Package names (@xsec/*) — only the "name" field changed
packages/cli/package.json         merge=ours
packages/core/package.json        merge=ours
packages/shared/package.json      merge=ours
packages/db/package.json          merge=ours
packages/templates/package.json   merge=ours
packages/benchmark/package.json   merge=ours
packages/llm-redteam/package.json merge=ours
packages/dashboard/package.json   merge=ours
packages/test-targets/package.json merge=ours
packages/desktop/package.json     merge=ours

# Assets / logos (our custom designs)
assets/xsec-aperture-ink.svg    merge=ours
assets/xsec-aperture-white.svg  merge=ours
assets/xsec-icon.gif            merge=ours

# CI workflows (our rebrand + pnpm fix)
.github/workflows/release.yml  merge=ours
.github/workflows/xverse.yml   merge=ours
.github/workflows/desktop-macos.yml merge=ours

# Docs (rebranded)
docs/**/*.md                    merge=ours
packages/cli/README.md         merge=ours
packages/core/README.md        merge=ours
packages/shared/README.md      merge=ours
packages/db/README.md          merge=ours
packages/templates/README.md   merge=ours
packages/benchmark/README.md   merge=ours
packages/llm-redteam/README.md merge=ours
packages/dashboard/README.md   merge=ours

# ── Code files (NO merge=ours — upstream changes flow through) ────────────
# These files have our rebrand strings BUT upstream may add new features.
# The post-merge-rebrand.sh script re-applies our 0sec→xsec replacements
# after merge, so both upstream features and our rebrand are preserved.
#
# Examples:
#   packages/core/src/runtime/llm-api.ts             (custom-openai provider)
#   packages/core/src/stages/tree-sitter-runtime.cjs (__XSEC_COMPILED_TARGET__)
#   packages/cli/src/tui/chat-screen.tsx              (cursor customization)
#   packages/cli/src/tui/chat/Composer.tsx            (cursor customization)
#   packages/cli/src/tui/provider-status.ts           (custom-openai)
#   packages/cli/src/tui/credential-store.ts          (custom-openai config)
#   packages/cli/src/tui/model-catalog-providers.ts   (provider fetchers)
#   packages/cli/src/tui/model-catalog-sync.ts        (merged catalog)
#   packages/cli/src/tui/connect-screen.tsx           (custom provider flow)
#   packages/cli/src/tui/connect-layout.ts            (custom provider text)
#   packages/desktop/src/main/sidecar.ts              (XSEC_DASHBOARD_READY)
#   packages/cli/src/desktop/console-gateway.ts       (@xsec imports)
#   packages/dashboard/src/api.ts                     (@xsec imports)
#   packages/dashboard/src/pages/chat-page.tsx        (@xsec imports)
#   scripts/smoke-desktop-macos.sh                    (xsec binary names)
#   scripts/smoke-cli.sh                              (XSEC_ env vars)
