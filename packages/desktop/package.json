{
  "name": "@xsec/desktop",
  "version": "0.15.0",
  "description": "Native desktop control plane for the XSEC security harness.",
  "author": "XSEC Labs",
  "repository": {
    "type": "git",
    "url": "https://github.com/uncesaii/xsec.git"
  },
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "desktopName": "xsec",
  "scripts": {
    "build": "tsc --project tsconfig.json",
    "start": "pnpm run build && electron .",
    "test": "vitest run",
    "package": "pnpm run build && node scripts/prepare-desktop-resources.mjs && electron-builder --publish never",
    "package:linux": "pnpm run build && node scripts/prepare-desktop-resources.mjs && electron-builder --publish never --linux",
    "package:mac": "pnpm run build && node scripts/prepare-desktop-resources.mjs && electron-builder --publish never --mac",
    "package:win": "pnpm run build && node scripts/prepare-desktop-resources.mjs && electron-builder --publish never --win",
    "clean": "rm -rf dist release resources"
  },
  "build": {
    "appId": "com.xsec.app",
    "productName": "xsec",
    "executableName": "xsec",
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "icon": "build/icon.png",
    "asar": true,
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources/dashboard",
        "to": "dashboard",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "resources/sidecars",
        "to": "sidecars",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "maintainer": "XSEC Labs",
      "syncDesktopName": true
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    }
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "electron": "42.11.2",
    "electron-builder": "26.15.2",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11"
  }
}
