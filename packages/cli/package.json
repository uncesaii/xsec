{
  "name": "xsec-cli",
  "version": "0.14.0",
  "description": "Open-source agentic AI pentest framework. Autonomously discover, exploit, and verify vulnerabilities in web apps, AI/LLM apps, source code, and npm/PyPI/Cargo/OCI packages.",
  "type": "module",
  "bin": {
    "xsec": "dist/index.js",
    "x": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@opentui/core": "0.5.4",
    "@opentui/react": "0.5.4",
    "@xsec/benchmark": "workspace:*",
    "@xsec/core": "workspace:*",
    "@xsec/llm-redteam": "workspace:*",
    "@xsec/db": "workspace:*",
    "@xsec/shared": "workspace:*",
    "@xsec/templates": "workspace:*",
    "@xsec/test-targets": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "pdfkit": "^0.15.2",
    "react": "^19.2.4",
    "react-devtools-core": "^7.0.1",
    "web-tree-sitter": "0.25.10",
    "ws": "^8.20.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/pdfkit": "^0.13.9",
    "@types/react": "^19.2.14",
    "typescript": "^5.7.2",
    "vitest": "^4.1.11",
    "yaml": "^2.4.0"
  }
}
