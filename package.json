{
  "name": "xsec",
  "type": "module",
  "version": "0.15.0",
  "description": "The open cybersecurity harness \u2014 evidence-first, agent-driven security research for authorized targets.",
  "bin": {
    "xsec": "dist/xsec.js",
    "0": "dist/xsec.js"
  },
  "files": [
    "LICENSE",
    "LICENSE-MIT",
    "NOTICE",
    "README.md",
    "package.json",
    "dist"
  ],
  "scripts": {
    "build": "node -e \"const fs=require('fs'),path=require('path');function walk(d){try{for(const e of fs.readdirSync(d,{withFileTypes:true})){const p=path.join(d,e.name);if(e.isDirectory()&&!e.name.startsWith('.')&&e.name!=='node_modules')walk(p);else if(e.name==='tsconfig.tsbuildinfo')try{fs.unlinkSync(p)}catch(e){}}}}catch(e){}}walk('.')\" && pnpm --filter @xsec/shared build && pnpm --filter @xsec/db --filter @xsec/templates build && pnpm --filter '!@xsec/docs' -r build && pnpm run build:bundle",
    "build:bundle": "node ./scripts/bundle-cli.mjs",
    "build:docs": "pnpm --filter @xsec/docs build",
    "dev": "pnpm -r --parallel dev",
    "lint": "pnpm --filter '!@xsec/docs' -r exec tsc --noEmit",
    "test": "pnpm test:public",
    "test:public": "pnpm --filter @xsec/core test && pnpm --filter @xsec/test-targets test && pnpm --filter xsec-cli test && pnpm test:runtime-lock && pnpm test:bundle-skills && pnpm test:public-source-export && node --test scripts/dsh-xsec-mcp.test.mjs && pnpm test:docs-pointers",
    "test:bundle-skills": "node --test scripts/bundle-skills-assets.test.mjs",
    "test:dsh-mcp:e2e": "node scripts/dsh-xsec-mcp.e2e.mjs",
    "test:install-e2e": "bash scripts/install-e2e.sh",
    "test:docs-pointers": "node --test scripts/docs-code-pointers.test.mjs",
    "test:runtime-lock": "node --test scripts/runtime-lock.test.mjs",
    "test:public-source-export": "node --test scripts/create-public-source-export.test.mjs",
    "export:public-source": "node scripts/create-public-source-export.mjs",
    "bench": "pnpm --filter @xsec/benchmark bench",
    "bench:quick": "pnpm --filter @xsec/benchmark bench:quick",
    "consolidate-xbow": "pnpm --filter @xsec/benchmark consolidate-xbow",
    "clean": "pnpm -r clean",
    "vulnerable": "PORT=43100 pnpm --filter @xsec/test-targets vulnerable",
    "safe": "PORT=43101 pnpm --filter @xsec/test-targets safe"
  },
  "keywords": [
    "security",
    "cybersecurity",
    "application-security",
    "penetration-testing",
    "red-team",
    "vulnerability-scanner",
    "ai-security",
    "llm-security",
    "llm",
    "prompt-injection",
    "mcp",
    "owasp",
    "sast",
    "fuzzing",
    "binary-analysis",
    "autonomous-agents",
    "security-research"
  ],
  "author": "XSEC Labs",
  "homepage": "",
  "bugs": {
    "url": ""
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uncesaii/xsec.git"
  },
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=24.0.0",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.15.9",
  "dependencies": {
    "@types/pdfkit": "^0.13.9",
    "drizzle-orm": "^0.45.2",
    "node-sqlite3-wasm": "^0.8.55",
    "pdfkit": "^0.15.2",
    "tree-sitter": "0.21.1",
    "tree-sitter-c": "0.21.4"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "esbuild": "^0.28.1"
  },
  "pnpm": {
    "overrides": {
      "esbuild": "^0.28.1",
      "brace-expansion": "^5.0.9",
      "js-yaml": "^4.3.1",
      "svgo": "^4.0.2",
      "ip-address": "^10.2.1",
      "nanoid@<3.3.18": "3.3.18",
      "hono": "^4.12.34",
      "@hono/node-server": "^1.19.15",
      "dompurify": "^3.4.13",
      "mermaid": "^11.16.1",
      "postcss": "^8.5.18",
      "fast-uri": "^3.1.3",
      "shell-quote": "^1.9.0",
      "body-parser@1": "^1.20.6",
      "body-parser@2": "^2.3.0"
    }
  }
}
